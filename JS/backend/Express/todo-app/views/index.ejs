<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>قائمة المهام</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<h1>قائمة المهام</h1>

<form action="/add" method="POST">
  <input type="text" name="title" placeholder="عنوان المهمة" required>
  <input type="text" name="description" placeholder="وصف المهمة">
  <select name="priority">
    <option value="منخفضة">منخفضة</option>
    <option value="متوسطة" selected>متوسطة</option>
    <option value="عالية">عالية</option>
  </select>
  <input type="date" name="due_date">
  <button type="submit">إضافة</button>
</form>

<hr>

<ul>
  <% tasks.forEach(task => { %>
    <li style="<%= task.completed ? 'text-decoration: line-through; color: red;' : '' %>">
      
      <strong><%= task.title %></strong> - <%= task.description %> - <%= task.priority %>

      <!-- زر Complete -->
      <form action="/toggle/<%= task.id %>" method="POST" style="display:inline;">
        <button type="submit">
          <%= task.completed ? 'إلغاء' : 'تم' %>
        </button>
      </form>

      <!-- زر حذف -->
      <form action="/delete/<%= task.id %>" method="POST" style="display:inline;">
        <button type="submit">حذف</button>
      </form>
      
    </li>
    <% if (!task.completed) { %>  
      <a style="background-color: aqua;" href="/edit/<%= task.id %>">تعديل</a>
    <% } %>
  <% }) %>
</ul>

</body>
</html>